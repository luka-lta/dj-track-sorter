  "description": "Sortiert DJ-Tracks anhand rekordbox MyTags in Genre-Ordner",
  "author": "luka-lta",
  "private": true,
  "main": "main/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:renderer && electron .",
